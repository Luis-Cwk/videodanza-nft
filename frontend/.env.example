# Wallet Connect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=YOUR_PROJECT_ID

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Site URL (used for NFT metadata animation_url)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agent endpoints
NEXT_PUBLIC_AGENT_URL=https://my-agent-tau.vercel.app
NEXT_PUBLIC_AGENT_ID=2387

# Smart Contract
NEXT_PUBLIC_CONTRACT_ADDRESS=0xe3145Ad5b6889DEd5659aC07051BD513Ae32B828
NEXT_PUBLIC_CHAIN_ID=11155111

# Sepolia RPC (used by server routes for on-chain activity)
SEPOLIA_RPC=https://ethereum-sepolia.publicnode.com

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
