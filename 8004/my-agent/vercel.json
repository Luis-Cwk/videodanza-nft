{
  "version": 2,
  "buildCommand": "echo 'No build needed - serverless functions only'",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/.well-known/agent-card.json", "destination": "/api/agent-card" },
    { "source": "/.well-known/agent-registration.json", "destination": "/well-known-agent-registration.json" },
    { "source": "/a2a", "destination": "/api/a2a" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/webhook", "destination": "/api/webhook-8004" },
    { "source": "/v1/premium-composition", "destination": "/api/premium-composition" },
    { "source": "/v1/agent-check/preview", "destination": "/api/agent-check-preview" },
    { "source": "/v1/agent-check", "destination": "/api/agent-check" },
    { "source": "/v1/prompt/analyze", "destination": "/api/prompt-analyze" },
    { "source": "/v1/contract", "destination": "/api/contract" }
  ],
  "headers": [
    {
      "source": "/.well-known/agent-card.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "functions": {
    "api/a2a.ts": {
      "maxDuration": 60
    },
    "api/mcp.ts": {
      "maxDuration": 60
    },
    "api/premium-composition.ts": {
      "maxDuration": 60
    },
    "api/agent-check.ts": {
      "maxDuration": 30
    },
    "api/agent-check-preview.ts": {
      "maxDuration": 30
    },
    "api/prompt-analyze.ts": {
      "maxDuration": 60
    },
    "api/contract.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}
